rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function familyMember(familyId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }
    function familyAdmin(familyId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.adminIds;
    }
    function memberOf(path) { return signedIn() && request.auth.uid in get(path).data.memberIds; }
    function description(value, kind) {
      return value is map && value.keys().hasOnly(['sdp', 'type']) && value.sdp is string && value.type == kind;
    }
    function createCall(chatPath) {
      let data = request.resource.data;
      return data.keys().hasOnly(['callerId', 'recipientId', 'memberIds', 'status', 'createdAt'])
        && data.callerId == request.auth.uid && data.recipientId is string
        && data.recipientId != request.auth.uid && data.memberIds is list
        && data.memberIds.size() == 2 && data.memberIds.hasAll([request.auth.uid, data.recipientId])
        && data.memberIds == get(chatPath).data.memberIds
        && data.status == 'preparing' && data.createdAt == request.time;
    }
    function updateCall() {
      let data = request.resource.data;
      let old = resource.data;
      let changed = data.diff(old).affectedKeys();
      return (request.auth.uid == old.callerId || request.auth.uid == old.recipientId) && (
        (request.auth.uid == old.callerId && old.status == 'preparing' && data.status == 'ringing'
          && changed.hasOnly(['offer', 'status']) && description(data.offer, 'offer'))
        || (request.auth.uid == old.recipientId && old.status == 'ringing' && data.status == 'accepted'
          && changed.hasOnly(['answer', 'status']) && description(data.answer, 'answer'))
        || (old.status in ['preparing', 'ringing', 'accepted'] && data.status == 'ended'
          && changed.hasOnly(['status', 'endedAt']) && data.endedAt == request.time)
        || (request.auth.uid == old.recipientId && old.status == 'ringing' && data.status == 'declined'
          && changed.hasOnly(['status', 'endedAt']) && data.endedAt == request.time)
      );
    }
    function candidateParticipant(callPath) {
      let call = get(callPath).data;
      return signedIn() && (request.auth.uid == call.callerId || request.auth.uid == call.recipientId);
    }
    function createCandidate() {
      let data = request.resource.data;
      return data.keys().hasOnly(['senderId', 'candidate', 'sdpMid', 'sdpMLineIndex', 'createdAt'])
        && data.senderId == request.auth.uid && data.candidate is string
        && (data.sdpMid == null || data.sdpMid is string)
        && (data.sdpMLineIndex == null || data.sdpMLineIndex is int)
        && data.createdAt == request.time;
    }
    function ownReadReceipt() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && request.resource.data.readBy.toSet() == resource.data.get('readBy', []).toSet().union([request.auth.uid].toSet());
    }
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'username', 'usernameLower', 'createdAt', 'lastSeen'])
        && request.resource.data.uid == userId
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameLower == resource.data.usernameLower
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']);
      allow delete: if false;
    }
    match /usernames/{username} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.usernameLower == username;
      allow update: if false;
      allow delete: if false;
    }

    // Personal conversations: no family membership or admin invitation needed.
    match /conversations/{conversationId} {
      function personalMember() { return memberOf(/databases/$(database)/documents/conversations/$(conversationId)); }
      // A first chat transaction must be able to read an absent deterministic ID.
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/conversations/$(conversationId)) || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['title', 'type', 'memberIds', 'adminIds', 'createdBy', 'lastMessage', 'createdAt', 'updatedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2 && request.resource.data.memberIds.size() <= 50
        && request.resource.data.memberIds.size() == request.resource.data.memberIds.toSet().size()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.adminIds == [request.auth.uid]
        && request.resource.data.title is string && request.resource.data.title.size() <= 100
        && request.resource.data.lastMessage is string
        && (request.resource.data.type == 'group' || (request.resource.data.type == 'direct' && request.resource.data.memberIds.size() == 2))
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if personalMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if personalMember();
        allow create: if verified() && personalMember()
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'type', 'readBy', 'createdAt', 'memberIds', 'mediaUrl', 'fileName', 'storagePath', 'audioBase64', 'audioMimeType', 'durationSeconds'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.get('readBy', [request.auth.uid]) == [request.auth.uid]
          && request.resource.data.type in ['text', 'image', 'video', 'audio']
          && (request.resource.data.type != 'text' || (request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000))
          && (request.resource.data.type != 'audio' || (
            request.resource.data.audioBase64 is string && request.resource.data.audioBase64.size() > 0 && request.resource.data.audioBase64.size() <= 800000
            && request.resource.data.audioMimeType in ['audio/webm', 'audio/mp4', 'audio/ogg']
            && request.resource.data.durationSeconds is int && request.resource.data.durationSeconds >= 1 && request.resource.data.durationSeconds <= 60
          ));
        allow update: if personalMember() && (
          ownReadReceipt() || (
            resource.data.senderId == request.auth.uid && resource.data.type == 'text'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
            && request.resource.data.editedAt == request.time
          )
        );
        allow delete: if personalMember() && (resource.data.senderId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds);
      }
      match /calls/{callId} {
        allow read: if personalMember();
        allow create: if verified() && personalMember() && createCall(/databases/$(database)/documents/conversations/$(conversationId));
        allow update: if personalMember() && updateCall();
        allow delete: if false;
        match /candidates/{candidateId} {
          allow read: if personalMember() && candidateParticipant(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId));
          allow create: if personalMember() && candidateParticipant(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)) && createCandidate();
          allow update, delete: if false;
        }
      }
    }

    // Keep existing family conversations and message permissions accessible.
    match /families/{familyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.auth.uid in request.resource.data.memberIds && request.auth.uid in request.resource.data.adminIds;
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow update: if familyAdmin(familyId);
      allow delete: if false;
      match /conversations/{conversationId} {
        function oldMember() { return familyMember(familyId) && memberOf(/databases/$(database)/documents/families/$(familyId)/conversations/$(conversationId)); }
        allow read: if familyMember(familyId) && request.auth.uid in resource.data.memberIds;
        allow create: if familyMember(familyId) && request.auth.uid in request.resource.data.memberIds;
        allow update: if familyMember(familyId) && request.auth.uid in resource.data.memberIds && request.auth.uid in request.resource.data.memberIds;
        allow delete: if familyAdmin(familyId);
        match /messages/{messageId} {
          allow read: if oldMember();
          allow create: if oldMember() && request.resource.data.senderId == request.auth.uid;
          allow update: if oldMember() && ((resource.data.senderId == request.auth.uid && request.resource.data.senderId == request.auth.uid) || ownReadReceipt());
          allow delete: if oldMember() && (resource.data.senderId == request.auth.uid || familyAdmin(familyId));
        }
        match /calls/{callId} {
          allow read: if oldMember();
          allow create: if oldMember() && createCall(/databases/$(database)/documents/families/$(familyId)/conversations/$(conversationId));
          allow update: if oldMember() && updateCall();
          allow delete: if false;
          match /candidates/{candidateId} {
            allow read: if oldMember() && candidateParticipant(/databases/$(database)/documents/families/$(familyId)/conversations/$(conversationId)/calls/$(callId));
            allow create: if oldMember() && candidateParticipant(/databases/$(database)/documents/families/$(familyId)/conversations/$(conversationId)/calls/$(callId)) && createCandidate();
            allow update, delete: if false;
          }
        }
      }
    }
  }
}
